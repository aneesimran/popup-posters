# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram chat ID; send /start to the bot to find it
ALLOWED_CHAT_ID=
# From https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# Optional: comma-separated models to try first. Leave empty for the fast defaults.
GEMINI_MODEL=
# Set automatically when you add Neon from the Vercel Marketplace
DATABASE_URL=
# Passcode for the web page
APP_PASSCODE=
# Your home postcode, used to show how far away each event is (straight-line miles)
HOME_POSTCODE=
# Key the Android app uses for /api/v1 (any long random string; openssl rand -hex 32)
APP_API_KEY=
